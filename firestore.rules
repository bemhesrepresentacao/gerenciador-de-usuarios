rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuário pode ler/criar/editar o próprio cadastro,
    // mas não pode mudar o próprio papel de user para admin.
    match /usuarios/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null &&
        (request.auth.uid == uid ||
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == "admin");
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
    }

    // O site público precisa ler perfis publicados.
    // Somente o usuário dono (ou admin) pode publicar/alterar.
    match /perfis/{slug} {
      allow read: if true;
      allow create: if request.auth != null
        && (request.resource.data.ownerUid == request.auth.uid ||
            get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == "admin");
      allow update: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid ||
            get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == "admin");
      allow delete: if false;
    }
  }
}